#!/usr/bin/env lua

argparse = require("argparse")
md5 = require("md5")
lfs = require("lfs")

local function get_package_path(scriptpath)
    if not scriptpath:match("^/") then
        scriptpath = lfs.currentdir() .. scriptpath:sub(2)
    end

    for _ = 1, 5 do
        local target = lfs.symlinkattributes(scriptpath, "target")
        if not target then
            break
        end

        if not target:match("^/") then
            local linkdir = scriptpath:match("(.*/)") or "./"
            scriptpath = linkdir .. target
        else
            scriptpath = target
        end
    end

    local scriptdir = scriptpath:match("(.*)/") or "."
    local searchpaths = {}
    for _, name in pairs({"fetchers", "utilities"}) do
        for _, ext in pairs({"lua", "sh"}) do
            table.insert(searchpaths, ("%s/uniplay/%s/?.%s"):format(os.getenv("XDG_CONFIG_HOME"), name, ext))
            table.insert(searchpaths, ("%s/../share/uniplay/%s/?.%s"):format(scriptdir, name, ext))
            table.insert(searchpaths, ("%s/%s/?.%s"):format(scriptdir, name, ext))
        end
    end

    return searchpaths
end

local parser = argparse("s-uniplay", "Universal player")
parser:argument("fetcher", "fetcher to use"):default("auto")
parser:argument("url", "url to fetch"):args("?")
parser:flag("-v --version", "print version")

local args = parser:parse()
if args.version then
    print("Uniplay: version 1.0")
    return
end

package.path = package.path .. ";" .. table.concat(get_package_path(arg[0]), ";")

print("path:", package.path)

local hfetcher = md5.sumhexa(args.fetcher)
local fetcherpath = package.searchpath(args.fetcher, package.path)
print("Found fetcher", fetcherpath)
return
